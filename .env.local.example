# Get your free API key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Optional: enables the "Get AI fund analysis" button. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: daily flip alert (see README). An ntfy topic such as
# https://ntfy.sh/your-long-random-topic gives free phone push notifications;
# any Slack/Discord/Zapier webhook that accepts a JSON POST also works.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=
RULE_COVERAGE=0.75
ALERT_ON_NEAR_TRIGGER=0
# Strongly recommended for the alert: any long random string.
CRON_SECRET=
